# Cloud Masking frontend — environment template (Vite reads VITE_-prefixed vars).
# Copy to `.env.local` (git-ignored) and adjust as needed. Consumed from Milestone 14.

# API base URL used by the axios client. In dev, leave as "/api" so requests go through the Vite
# same-origin proxy (see vite.config.ts) — no backend CORS change required.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards "/api/*" (the running M13 FastAPI backend).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_APP_NAME=Cloud Masking
