# Root environment template for the Cloud Masking project.
# Component-specific templates: backend/.env.example and frontend/.env.example.
# Copy the relevant template(s) to `.env` / `.env.local` (git-ignored) for local development.
#
# Milestone 2: nothing consumes these yet; configuration is a skeleton until later milestones.

# Backend (mirror of backend/.env.example essentials)
APP_ENV=development
RUN_PROFILE=smoke
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
RANDOM_SEED=42

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------------------------
# Docker deployment (Milestone 17) — consumed by docker/docker-compose.yml. No secrets here.
# Copy to a git-ignored `.env` beside the compose file (or the repo root) to override host ports.
# ---------------------------------------------------------------------------------------------
# Host ports published by Compose (container ports 8000/80 are fixed):
BACKEND_PORT=8000        # -> http://localhost:8000  (API + /docs)
FRONTEND_PORT=8080       # -> http://localhost:8080  (SPA; proxies /api -> backend)
# In-container overrides (already set by compose; listed for reference — do NOT put secrets here):
# API_HOST=0.0.0.0
# OUTPUTS_DIR=/data
# DATABASE_URL=sqlite:////data/cloud_masking.db   # persisted on the named volume cloud-masking-data
# MLFLOW_TRACKING_URI=file:/data/mlruns
