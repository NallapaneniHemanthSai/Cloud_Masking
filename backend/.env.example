# Cloud Masking backend — environment variable template.
# Copy to `.env` (which is git-ignored) and adjust. Milestone 2: values are documented defaults; nothing
# reads a real `.env` yet (configuration is a skeleton until Milestone 13).

# --- Runtime / profile -------------------------------------------------------------------------
APP_ENV=development
RUN_PROFILE=smoke            # smoke | full  (see ADR-0002 frozen resource envelope)

# --- API ---------------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Logging -----------------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Paths (leave blank to use project-relative defaults; never hardcode absolute paths) --------
# DATA_DIR=
# MODELS_DIR=
# OUTPUTS_DIR=

# --- Experiment tracking / database ------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./outputs/mlruns
DATABASE_URL=sqlite:///./outputs/cloud_masking.db

# --- Reproducibility ---------------------------------------------------------------------------
RANDOM_SEED=42
